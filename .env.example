# Groq API Key for LLM report explanations (required for live LLM insights)
GROQ_API_KEY=

# Hugging Face token (optional for public models like sentence-transformers/all-MiniLM-L6-v2)
HUGGINGFACEHUB_API_TOKEN=

# Embedding model identifier
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum PDF upload size in bytes (default: 5 MB)
MAX_FILE_SIZE=5242880

# SQLite / Database Connection URL
DATABASE_URL=sqlite:///./data/resumes.db
